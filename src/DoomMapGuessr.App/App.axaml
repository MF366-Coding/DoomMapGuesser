<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
			 x:Class="DoomMapGuessr.App"
             RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.Resources>
		<ResourceDictionary>
			<!-- merged dictionaries -->
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://DoomMapGuessr.App/Styles/Colors.axaml" />
				<ResourceInclude Source="avares://DoomMapGuessr.App/Icons/MaterialSymbols.axaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- fonts -->
			<FontFamily x:Key="CascadiaCode">
				avares://DoomMapGuessr.App/Assets/Fonts/cascadia-code.ttf#Cascadia Code
			</FontFamily>

			<!-- converters -->
			<converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />

		<!-- Custom Styles -->
		<StyleInclude Source="avares://DoomMapGuessr.App/Styles/Controls.axaml" />
		<StyleInclude Source="avares://DoomMapGuessr.App/Styles/Card.axaml" />
	</Application.Styles>

</Application>